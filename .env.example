# ---------------------------------------------------------------------------
# TrueUp — environment template
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# ---------------------------------------------------------------------------

# --- Request Network (the live project we integrate with) -------------------
# Client ID identifies our application. Sent as the `x-client-id` header.
# Created in the RN dashboard AFTER a payment destination exists, or via
# POST https://auth.request.network/v1/client-ids
RN_CLIENT_ID=

# Webhook signing secret. Returned ONCE in the body of
# POST https://auth.request.network/v1/webhook — save it immediately, it is
# never shown again. Used server-side for HMAC-SHA256 over the RAW request body,
# compared against the `x-request-network-signature` header.
RN_WEBHOOK_SECRET=

# Payment destination. A composite value:
#   <humanReadableInteropAddress(ERC-7828)>:<tokenAddress>
# e.g. 0x6923...C7D7@eip155:1#1f969856:0x036CbD53842c5426634e7929541eC2318f3dCF7e
RN_DESTINATION_ID=

# API base URLs
RN_API_BASE=https://api.request.network
RN_AUTH_BASE=https://auth.request.network

# --- KeeperHub (the execution layer) ---------------------------------------
# Organization key (prefix `kh_`), created at avatar -> API Keys -> Organisation.
# Validates with GET /api/keys (200 = valid). Use this for REST and MCP.
KH_API_KEY=
KH_API_BASE=https://app.keeperhub.com/api
KH_MCP_URL=https://app.keeperhub.com/mcp

# Organization wallet — read from GET /api/user. This is the address that gets
# funded, NOT the address you signed in with.
KH_ORG_WALLET=

# Chain ids are STRINGS.
#   Ethereum 1 | Sepolia 11155111 | Base 8453 | Base Sepolia 84532
#   Arbitrum 42161 | Polygon 137 | Tempo 4217 | Tempo testnet 42431
KH_CHAIN_ID=11155111

# --- TrueUp bridge ---------------------------------------------------------
BRIDGE_PORT=8787
# Public URL RN should deliver webhooks to (cloudflared / ngrok in dev)
BRIDGE_PUBLIC_URL=

# Trust level above which a matched payment pays out automatically.
# Below it, we stage a KeeperHub Sign & Hold Payment for human release.
MATCH_AUTO_APPROVE_THRESHOLD=0.85
